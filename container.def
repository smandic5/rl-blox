Bootstrap: docker
From: python:3.12.12-slim

%files
    requirements.txt /opt/rl-blox/requirements.txt

%post
    echo "Installing Python dependencies..."
    ls

    # Install pip packages
    python3 -m pip install --upgrade pip
    pip install --no-cache-dir -r /opt/rl-blox/requirements.txt
    pip install --no-cache-dir aim ott-jax

    echo "Python-Image configured."

%runscript
    echo "Container running. Starting Python-Shell."
    exec python3
